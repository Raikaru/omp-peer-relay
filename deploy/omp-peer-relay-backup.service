[Unit]
Description=Snapshot the omp peer relay database
After=omp-peer-relay.service

[Service]
Type=oneshot
User=omp-relay
Group=omp-relay
UMask=0077
ExecStart=/opt/omp-peer-relay/omp-peer-relay backup -db /var/lib/omp-peer-relay/relay.db -dir /var/lib/omp-peer-relay/backups -keep 14
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/omp-peer-relay
